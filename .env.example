# Copy this file to .env and fill in your own values. NEVER commit .env to GitHub.

# Which API to use: anthropic | openai   ("openai" works with any OpenAI-compatible endpoint)
LLM_PROVIDER=anthropic
LLM_API_KEY=your_key_here
# Model name for your provider (change if your key has access to a different model)
LLM_MODEL=claude-sonnet-5-5
# Only for LLM_PROVIDER=openai (leave empty for the official OpenAI API)
LLM_BASE_URL=
# Seconds to wait for the API before giving up
LLM_TIMEOUT=60
